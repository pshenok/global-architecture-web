{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "types": "off"
  },
  "ignoreIssues": {
    "src/ui/primitives/**": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": ["tools/*.ts", "tests/support/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "tools/**/*.ts", "tests/**/*.ts"],
      "ignore": ["tests/probes/**"],
      "ignoreDependencies": [
        "@axe-core/playwright",
        "axe-core",
        "vitest-browser-react",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "tools/api-codegen": {}
  }
}
