  "info": {
    "title": "Global Architecture Monolith API",
    "description": "Public REST API. Every error is RFC 9457 application/problem+json with a stable `code`. Send an OIDC access token as `Authorization: Bearer <token>`; register once with `POST /v1/users`. Send x-request-id to correlate your logs with ours.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always \"about:blank\"; use `code` to branch on errors."
          },
          "title": {
            "type": "string",
            "description": "HTTP reason phrase."
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "description": "Human-readable explanation (omitted for 5xx).",
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Request path."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable reason, e.g. USER_EMAIL_TAKEN or NOT_FOUND."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "errors": {
            "description": "Invalid fields (validation errors).",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "requestId": {
            "type": "string",
            "description": "Correlation id, also in the x-request-id header."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "requestId"
        ],
        "additionalProperties": false
      },
      "RegisterUserBody": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "fullName"
        ]
      },
      "User": {
        "type": "object",
