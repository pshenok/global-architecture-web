# Server configuration, validated at start (src/platform/config/env.ts). Locally `pnpm dev`
# writes .env.local from the monolith's registry; this file documents production.
# There are no NEXT_PUBLIC_ variables: nothing here reaches the browser.

# The app's own origin (https://, or http://localhost:<port> in development)
APP_ORIGIN=https://web.example.com
# The monolith API's origin (https)
API_BASE_URL=https://api.example.com
# The OIDC provider; this app is a confidential client using code + PKCE
OIDC_ISSUER=https://login.example.com
OIDC_CLIENT_ID=gaw-web
OIDC_CLIENT_SECRET=
# Default: openid email offline_access (refresh tokens)
OIDC_SCOPES=openid email offline_access
# Extra authorization parameters as JSON, e.g. {"audience":"https://api.example.com"}
OIDC_AUTH_PARAMS={}
# Back-channel endpoints on other origins (comma-separated https origins)
OIDC_EXTRA_ORIGINS=
# Session cookie keys: [{"kid":"2026-10","key":"<base64url of 32 random bytes>"}]; the
# first seals, all open. Rotate: prepend a new key, deploy, drop the old after SESSION_MAX_AGE_S.
SESSION_KEYS=
# Absolute session lifetime in seconds (300..604800); match the provider's refresh lifetime
SESSION_MAX_AGE_S=28800
LOG_LEVEL=info
