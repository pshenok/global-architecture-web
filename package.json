{
  "name": "global-architecture-web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js App Router BFF for global-architecture-monolith: OIDC on the server, one encrypted session cookie in the browser, a typed API client generated from the monolith's OpenAPI document, enforced feature boundaries, a feature template and Claude Code skills.",
  "type": "module",
  "license": "UNLICENSED",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "node tools/dev.ts",
    "build": "next build && node tools/check-build.ts",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "lint": "next typegen && biome ci . && node tools/check-access.ts && node tools/check-boundaries.ts && node tools/check-text.ts && oxlint && knip",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck",
    "api:sync": "node tools/api-sync.ts",
    "api:check": "node tools/api-sync.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "jose": "6.2.13",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "openapi-fetch": "0.17.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "knip": "6.44.0",
    "msw": "3.0.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0"
  }
}
